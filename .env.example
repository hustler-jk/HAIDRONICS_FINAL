# In Google Cloud Console, configure the OAuth consent screen and create an
# OAuth 2.0 Client ID with application type "Web application".
# Add the callback URL for each environment to Authorized redirect URIs:
# http://localhost:3000/api/oauth/google/callback
# For production, register https://your-domain.example/api/oauth/google/callback
# and set GOOGLE_REDIRECT_URI to that exact URI.
# Keep the client secret server-side; never add it to a VITE_ variable.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Required by signed application sessions and customer/password accounts.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Supabase Dashboard > Project Settings > Database > Connection string.
# Prefer the session pooler when deploying to serverless; this app uses SSL
# and disables prepared statements for compatibility with Supabase poolers.
DATABASE_URL=

# Resend transactional email (signup verification and invoice email after payment verification).
# Verify the sender domain in Resend, then use an address on that domain.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=HAIDRONICS <invoices@your-verified-domain.example>
PUBLIC_APP_URL=https://your-domain.example

# Admin image uploads: create a public bucket in Supabase Storage, then set
# these server-only credentials. The service role key must never use a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=haidronics-media
